# Config files
~/.claude/settings.json
~/.claude/settings.local.json   # Not inserted into version control, subcribe settings.json

# Some commands
/theme
/config
/model

# Clear current session and context window
/clear

# Token usage
/context
/usage

# Initiate claude with a prompt.
claude "explain this project"
# Run in background.
claude -p "explain this project"

# Continue a session.
/resume

# Continue from the last session.
claude -c

# Avoid claude touch in other files out of the project. 
docker sandbox run claude
# Or use.
/sandbox

