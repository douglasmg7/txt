# JSON processor.

# Install.
sudo pacman -S jq

# Site.
https://github.com/stedolan/jq/

# Print file
jq . file_name.json

# Compact print
jq -c . file_name.json

# Sorted
jq -S . file_name.json

# Get some item with no quotes.
jq -r .name file_name.json

# Get some array item.
jq .[0] file_name.json
